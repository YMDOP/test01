# 统一换行符处理，避免 Windows / Linux 之间产生无意义的整文件 diff
* text=auto

# 明确按文本处理
*.java      text
*.xml       text
*.yml       text
*.yaml      text
*.properties text
*.md        text
*.ts        text
*.tsx       text
*.js        text
*.jsx       text
*.css       text
*.json      text
*.sql       text
*.gitignore text

# 明确按二进制处理
*.jar       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.ico       binary
*.woff      binary
*.woff2     binary
